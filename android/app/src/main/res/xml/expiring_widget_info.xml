<?xml version="1.0" encoding="utf-8"?>
<!-- v1.6：临期小部件元信息。updatePeriodMillis=30 分钟：系统周期性触发 onUpdate，
     原生侧用快照里的到期毫秒现算「剩X天」，无需打开 App 数字也保持新鲜。
     v1.7：放宽下限至 2x1（110x40dp），Provider 按实际高度分档显 1/3/5 行。 -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/expiring_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_expiring_desc" />
